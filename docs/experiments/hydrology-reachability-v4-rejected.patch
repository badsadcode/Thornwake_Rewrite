+using System.Diagnostics;
+using System.Security.Cryptography;
+using System.Text.Json;
+using Thornwake.Core;
+
+internal static class HydrologyReachabilityTests
+{
+    private static readonly JsonSerializerOptions Json=new(){WriteIndented=true,Converters={new System.Text.Json.Serialization.JsonStringEnumConverter()}};
+    internal static string Hash<T>(T value)=>Convert.ToHexString(SHA256.HashData(JsonSerializer.SerializeToUtf8Bytes(value))).ToLowerInvariant();
+    // Execution metrics and discovery-order diagnostic evidence are versioned work, not geography.
+    internal static string Geography(HydrologyTopologyResult r)=>Hash(new{r.CandidateId,r.CandidateStage,r.QueryCell,r.ComponentStop,r.SpillStop,
+        r.FinalComponentId,r.ComponentCells,r.SpillProposal,r.OriginalOutlets,r.Frontier,r.Continuation});
+    public static int Run(bool verify=true)
+    {
+        int checks=HydrologyTopologyTests.Run(verify:verify,includeWorlds:false,algorithm:4);
+        void Check(bool ok,string why){if(!ok)throw new Exception("REACHABILITY: "+why);checks++;}
+        var worlds=JsonSerializer.Deserialize<AcceptedWorldTests.TerrainFixture>(File.ReadAllText(Path.Combine(AppContext.BaseDirectory,"Fixtures/terrain-a4-v1.json")))!;
+        var regional=RegionalDrainageRefiner.Create(MacroDrainageRecipe.Create(worlds.Cases.Single(c=>c.Name=="mountainous/42").World));
+        var recipe=new HydrologyTopologyRecipe(1,4,new(1,1,2,regional.Recipe),3,.03125,1,.01,new(16,100000,100000,200000,8192,10000));
+        ReconciliationDomain Domain(double[] faces,bool opening=false,double receiver=0)
+        {
+            double Terrain(MacroPoint p)
+            {
+                double sill=3*Math.Max(0,1-Math.Abs(p.X-16));
+                if(opening)sill*=Math.Clamp((Math.Abs(p.Z-5.5)-.25)/.25,0,1);
+                double bed=1+40*Math.Max(0,Math.Abs(p.Z-6)-1)+40*Math.Max(0,Math.Max(5-p.X,p.X-18))+sill;
+                foreach(double face in faces)bed+=19*Math.Max(0,1-Math.Abs(p.X-face)/.25)*Math.Max(0,1-Math.Abs(p.Z-5.25)/.125)+
+                    5*Math.Max(0,1-Math.Abs(p.X-face-.5)/.5)*Math.Max(0,1-Math.Abs(p.Z-5.5)/.5);
+                return bed;
+            }
+            return new("graph-reuse","basin",3,0,0,4,5,3,4,Terrain,
+                patch=>patch==9?new[]{new ReconciliationExit("receiver",new(9,5),new(17.5,5.5),receiver)}:Array.Empty<ReconciliationExit>(),
+                (a,b)=>Array.Empty<DrainagePort>(),patch=>Array.Empty<DrainagePort>());
+        }
+        checks+=AdaptiveBasinTopology.TestReachabilityProofs(Domain(new[]{8d}),recipe);
+        var reports=new List<object>();
+        ReachabilityExperiment Compare(string name,ReconciliationDomain d,HydrologyTopologyRecipe? r=null,int patch=6)
+        {
+            r??=recipe;
+            var reused=AdaptiveBasinTopology.ProfileReachability(d,r,patch,5);
+            var plain=AdaptiveBasinTopology.ProfileReachability(d,r,patch,5,reuse:false);
+            Check(Geography(reused.Result)==Geography(plain.Result),"all geographic result fields match full restart: "+name);
+            Check(Hash(reused.Result)==Hash(AdaptiveBasinTopology.Run(d,r,patch,5)),"instrumentation has no effect: "+name);
+            Check(reused.Reachability.PeakCells<=131072 && reused.Reachability.RepairWork<=16000000,"dependency/work bound: "+name);
+            reports.Add(new{name,reused,plain});return reused;
+        }
+        var d=Domain(new[]{8d,12d,16d});var multi=Compare("sequential",d);
+        Compare("leaf",Domain(new[]{8d}));Compare("late",Domain(new[]{12d}));
+        var spill=Compare("spill-parent",Domain(new[]{16d}));
+        var other=Compare("other-entry",d,patch:8);
+        var opening=Compare("opening",Domain(new[]{8d,12d},opening:true));
+        var receiver=Compare("receiver",Domain(new[]{8d,12d},opening:true,receiver:7));
+        Check(opening.Result.SpillProposal!.RequiredElevation==1 && receiver.Result.SpillProposal!.RequiredElevation==7,"opening and receiver remain binding");
+        Check(multi.Reachability.PreservedCells>0 && multi.Reachability.Repairs>1,"multiple corrections preserve proven branches");
+        var noRepair=AdaptiveBasinTopology.ProfileReachability(d,recipe,6,5,repairWorkLimit:0);
+        Check(noRepair.Reachability.BudgetFallbacks>0 && noRepair.Reachability.FullRestarts>0,"invalidation budget falls back");
+        Check(Geography(noRepair.Result)==Geography(multi.Result),"fallback preserves geography");
+        foreach(var limits in new[]{recipe.Limits with{Passes=1},recipe.Limits with{Samples=30},recipe.Limits with{Cells=10},recipe.Limits with{Splits=0},
+            recipe.Limits with{NodeVisits=1},recipe.Limits with{Patches=1,FrontierEntries=1}})
+        {
+            var r=recipe with{Limits=limits};var limited=AdaptiveBasinTopology.ProfileReachability(d,r,6,5);
+            Check(limited.Result.FinalComponentId==null && limited.Result.Continuation!=null,"budget cannot certify closure");
+            Check(Hash(limited.Result)==Hash(AdaptiveBasinTopology.Run(d,r,6,5)),"budget result deterministic");
+            var token=JsonSerializer.Deserialize<HydrologyTopologyContinuation>(JsonSerializer.Serialize(limited.Result.Continuation))!.Expand(recipe.Limits);
+            Check(token.Recipe.Algorithm==4 && Hash(AdaptiveBasinTopology.Run(d,token.Recipe,6,5))==Hash(multi.Result),"versioned continuation equals one shot");
+        }
+        foreach(string moment in new[]{"repair","preserve","descendant","invalidate-member"})
+        {
+            using var cancel=new CancellationTokenSource();bool observed=false,cancelled=false;
+            try{AdaptiveBasinTopology.ProfileReachability(d,recipe,6,5,cancellation:cancel.Token,observer:e=>{if(e==moment){observed=true;cancel.Cancel();}});}
+            catch(OperationCanceledException){cancelled=true;}
+            Check(observed && cancelled,"cancellation during "+moment);
+        }
+        var parallel=Task.WhenAll(Enumerable.Range(0,3).Select(_=>Task.Run(()=>Hash(AdaptiveBasinTopology.ProfileReachability(d,recipe,6,5))))).GetAwaiter().GetResult();
+        Check(parallel.All(h=>h==Hash(multi)),"parallel independent queries");
+        Directory.CreateDirectory("artifacts/hydrology-reachability");
+        File.WriteAllText("artifacts/hydrology-reachability/analytic.json",JsonSerializer.Serialize(reports,Json));
+        Console.WriteLine($"REACHABILITY_PASS: {checks} checks; preserved {multi.Reachability.PreservedCells}, invalidated {multi.Reachability.InvalidatedCells}");return checks;
+    }
+    public static int VerifySupportedWorlds()
+    {
+        int checks=0;void Check(bool ok,string why){if(!ok)throw new Exception("REACHABILITY_WORLD: "+why);checks++;}
+        var worlds=JsonSerializer.Deserialize<AcceptedWorldTests.TerrainFixture>(File.ReadAllText(Path.Combine(AppContext.BaseDirectory,"Fixtures/terrain-a4-v1.json")))!;
+        using var matrix=JsonDocument.Parse(File.ReadAllText("artifacts/hydrology-reachability/comparison.json"));
+        foreach(var row in matrix.RootElement.EnumerateArray().Where(e=>e.GetProperty("Mode").GetInt32()==2 && e.GetProperty("ComponentStop").GetString()==nameof(TopologyStop.SupportedAtSampleSpacing)))
+        {
+            var world=worlds.Cases.Single(c=>c.Name==row.GetProperty("World").GetString()).World;
+            var regional=RegionalDrainageRefiner.Create(MacroDrainageRecipe.Create(world));int patch=row.GetProperty("Patch").GetInt32();
+            var recipe=new HydrologyTopologyRecipe(1,4,new(1,1,2,regional.Recipe),3,2,64,.25,new(32,2000000,800000,2000000,16384,180000));
+            var original=AdaptiveHydrologyReconciler.Restore(recipe with{Algorithm=3}).Reconcile(patch);
+            var experimental=AdaptiveHydrologyReconciler.Restore(recipe).Reconcile(patch);
+            Check(Hash(experimental)==row.GetProperty("Fingerprint").GetString(),"complete experimental reconstruction matches measured result");
+            Check(original.ComponentStop==TopologyStop.SupportedAtSampleSpacing,"supported comparison requires a complete safe oracle");
+            Check(original.ComponentCells.SequenceEqual(experimental.ComponentCells) && original.QueryCell==experimental.QueryCell,"every real supported member equals algorithm 3, not only component size");
+            Console.WriteLine($"REACHABILITY_WORLD {row.GetProperty("World").GetString()}: {experimental.ComponentCells.Count} members identical to algorithm 3");
+        }
+        Check(checks>0,"matrix contains a supported component to compare");
+        Console.WriteLine($"REACHABILITY_WORLD_PASS: {checks} checks");return checks;
+    }
+    public static int Measure()
+    {
+        int checks=0;void Check(bool ok,string why){if(!ok)throw new Exception("REACHABILITY: "+why);checks++;}
+        var rows=new List<object>();
+        var worlds=JsonSerializer.Deserialize<AcceptedWorldTests.TerrainFixture>(File.ReadAllText(Path.Combine(AppContext.BaseDirectory,"Fixtures/terrain-a4-v1.json")))!;
+        using var frozen=JsonDocument.Parse(File.ReadAllText(Path.Combine(AppContext.BaseDirectory,"Fixtures/hydrology-work-coverage-v1.json")));
+        foreach(var group in new[]{(World:"mountainous/42",Sizes:new[]{"large","small"}),
+            (World:"mountainous/42/far",Sizes:new[]{"large"}),(World:"vast-world/7319/far",Sizes:new[]{"small","large","medium"})})
+        {
+            var regional=RegionalDrainageRefiner.Create(MacroDrainageRecipe.Create(worlds.Cases.Single(c=>c.Name==group.World).World));
+            foreach(string size in group.Sizes)
+            {
+                var expected=frozen.RootElement.EnumerateArray().Single(r=>r.GetProperty("World").GetString()==group.World && r.GetProperty("Size").GetString()==size && r.GetProperty("Algorithm").GetInt32()==3);
+                int patch=expected.GetProperty("Patch").GetInt32();
+                var recipe=new HydrologyTopologyRecipe(1,4,new(1,1,2,regional.Recipe),3,2,64,.25,new(32,2000000,800000,2000000,16384,180000));
+                foreach(int mode in new[]{0,1,2})
+                {
+                    var r=mode<2?recipe with{Algorithm=3}:recipe;
+                    var domain=HydrologyReconciler.Create(regional).CreateDomain(patch,CancellationToken.None);
+                    var watch=Stopwatch.StartNew();
+                    var result=mode<2?AdaptiveBasinTopology.RunGraphExperiment(domain,r,patch,null,reuse:mode==1):AdaptiveBasinTopology.Run(domain,r,patch,null);
+                    watch.Stop();domain=HydrologyReconciler.Create(regional).CreateDomain(patch,CancellationToken.None);
+                    ReachabilityExperiment? reuse=null;HydrologyGraphProfile graph;HydrologyTopologyResult profiled;
+                    if(mode==2){reuse=AdaptiveBasinTopology.ProfileReachability(domain,r,patch,null);profiled=reuse.Result;graph=reuse.Graph;}
+                    else{var p=AdaptiveBasinTopology.ProfileGraph(domain,r,patch,null,reuse:mode==1);profiled=p.Result;graph=p.Graph;}
+                    Check(Hash(result)==Hash(profiled),"instrumentation preserves result");
+                    if(mode<2)Check(Hash(result)==expected.GetProperty("Fingerprint").GetString(),"historical frozen algorithm 3 unchanged");
+                    Check(result.Metrics.NodeVisits<=recipe.Limits.NodeVisits,"same visit budget");
+                    rows.Add(new{group.World,Size=size,Patch=patch,Mode=mode,Milliseconds=watch.Elapsed.TotalMilliseconds,result.Metrics,
+                        result.ComponentStop,result.SpillStop,ComponentCells=result.ComponentCells.Count,Fingerprint=Hash(result),
+                        Frontiers=result.Frontier.GroupBy(f=>f.Reason).OrderBy(g=>g.Key).ToDictionary(g=>g.Key,g=>g.Count()),Graph=graph,Reachability=reuse?.Reachability});
+                    Console.WriteLine($"REACH {group.World}/{size} mode={mode}: {watch.Elapsed.TotalMilliseconds:F0}ms, {result.ComponentStop}/{result.SpillStop}, visits {result.Metrics.NodeVisits}, repeated wet {graph.Passes.Sum(p=>p.RepeatedWetVisits)}, preserved {reuse?.Reachability.PreservedCells}");
+                    Directory.CreateDirectory("artifacts/hydrology-reachability");
+                    File.WriteAllText("artifacts/hydrology-reachability/comparison.json",JsonSerializer.Serialize(rows,Json));
+                }
+            }
+        }
+        Console.WriteLine($"REACHABILITY_MEASUREMENT_PASS: {checks} checks; {rows.Count} queries");return checks;
+    }
+}
diff --git a/Tests/HydrologyReachabilityProofTests.cs b/Tests/HydrologyReachabilityProofTests.cs
new file mode 100644
--- /dev/null
+++ b/Tests/HydrologyReachabilityProofTests.cs
@@ -0,0 +1,80 @@
+using Thornwake.Core;
+
+// Test-only partial access keeps synthetic dependency corruption/retirement fixtures out of Core.
+namespace Thornwake.Core;
+internal sealed partial class AdaptiveBasinTopology
+{
+    internal static int TestReachabilityProofs(ReconciliationDomain domain,HydrologyTopologyRecipe recipe)
+    {
+        int checks=0;void Check(bool ok,string why){if(!ok)throw new Exception("REACHABILITY_PROOF: "+why);checks++;}
+        (AdaptiveBasinTopology Search,Cell[] Cells) Fixture(int? limit=null)
+        {
+            var search=new AdaptiveBasinTopology(domain,recipe,CancellationToken.None);
+            if(limit.HasValue)search._reach!.WorkLimit=limit.Value;
+            var cells=new[]{new Cell(new(0,0,8),1,1,false,null),new Cell(new(8,0,8),1,1,false,null),
+                new Cell(new(16,0,8),1,1,false,null),new Cell(new(24,0,8),1,1,false,null),
+                new Cell(new(0,8,8),1,1,false,null),new Cell(new(8,8,8),1,1,false,null),new Cell(new(16,8,8),1,1,false,null)};
+            search.PrepareReachability(cells[0],new(),new());
+            foreach(var (child,parent) in new[]{(1,0),(2,1),(3,2),(4,0),(5,4),(6,5)})search.DiscoverReachability(cells[child],cells[parent]);
+            foreach(var c in cells)
+            {
+                var neighbours=cells.Where(n=>PositiveFace(c.Key,n.Key)).ToArray();
+                search._expansions![c.Key]=new(c,c.Generation,neighbours,neighbours.Select(n=>n.Generation).ToArray());
+                search.CompleteReachability(c);
+            }
+            return(search,cells);
+        }
+        static void Retire(Cell c){c.Children=Array.Empty<Cell>();c.Generation++;}
+        static (SortedDictionary<HydrologyCell,Cell> Wet,SortedDictionary<HydrologyCell,Cell> Pending) Repair(AdaptiveBasinTopology s,Cell seed)
+        {
+            var wet=new SortedDictionary<HydrologyCell,Cell>();var pending=new SortedDictionary<HydrologyCell,Cell>{{seed.Key,seed}};
+            s.PrepareReachability(seed,wet,pending);return(wet,pending);
+        }
+        var (s,c)=Fixture();var first=Repair(s,c[0]);
+        Check(first.Wet.Count==7 && first.Pending.Count==0,"unchanged full tree preserved");
+        Retire(c[1]);var corrected=Repair(s,c[0]);
+        Check(!s._reach!.Nodes.ContainsKey(c[2].Key) && !s._reach.Nodes.ContainsKey(c[3].Key),"high ancestor invalidates all descendants even when leaf geometry survives");
+        Check(s._reach.Descendants==2 && s._reach.OldInvalidated==3,"previously preserved descendants are invalidated");
+        Check(corrected.Wet.ContainsKey(c[4].Key),"unrelated seed-connected branch survives");
+        Check(corrected.Pending.ContainsKey(c[0].Key) && corrected.Pending.ContainsKey(c[5].Key) && corrected.Pending.ContainsKey(c[6].Key),"closure: unchanged surviving face to an orphan must be requeued");
+        // Exercise the repaired queue to closure, then compare with independent cold flood fill.
+        while(corrected.Pending.Count>0)
+        {
+            var next=corrected.Pending.First().Value;corrected.Pending.Remove(next.Key);
+            if(!corrected.Wet.TryAdd(next.Key,next))continue;
+            foreach(var neighbour in c.Where(n=>n.Children==null && PositiveFace(next.Key,n.Key)))
+                if(!corrected.Wet.ContainsKey(neighbour.Key))
+                {corrected.Pending.TryAdd(neighbour.Key,neighbour);s.DiscoverReachability(neighbour,next);}
+            s.CompleteReachability(next);
+        }
+        var cold=new HashSet<HydrologyCell>();var todo=new Queue<Cell>();todo.Enqueue(c[0]);
+        while(todo.TryDequeue(out var current))
+            if(cold.Add(current.Key))foreach(var neighbour in c.Where(n=>n.Children==null && PositiveFace(current.Key,n.Key)))todo.Enqueue(neighbour);
+        Check(cold.SetEquals(corrected.Wet.Keys) && cold.Count==6,"repaired closure equals full flood fill through alternate face");
+        Check(s._reach.Nodes[c[2].Key].Parent!.Cell==c[6],"rediscovered branch acquires the surviving alternate parent");
+        // A surviving face can rediscover the orphan only after normal face validation. No old
+        // parent is retained: emulate that validated discovery from the lower connected branch.
+        s.DiscoverReachability(c[2],c[6]);s.DiscoverReachability(c[3],c[2]);
+        var reattached=Repair(s,c[0]);
+        Check(reattached.Pending.ContainsKey(c[2].Key) && s._reach.Nodes[c[2].Key].Parent!.Cell==c[6],"orphan requires fresh validated discovery parent");
+        Retire(c[6]);Repair(s,c[0]);
+        Check(!s._reach.Nodes.ContainsKey(c[2].Key) && !s._reach.Nodes.ContainsKey(c[3].Key),"later correction invalidates rediscovered descendants");
+        var (leaf,lc)=Fixture();Retire(lc[3]);var lr=Repair(leaf,lc[0]);
+        Check(leaf._reach!.Descendants==0 && lr.Wet.Count==5,"leaf correction preserves remote ancestors");
+        var (seed,sc)=Fixture();Retire(sc[0]);var replacement=new Cell(sc[0].Key,0,0,false,null);var sr=Repair(seed,replacement);
+        Check(seed._reach!.SeedChanges==1 && sr.Wet.Count==0 && seed._reach.Nodes.Count==1,"changed canonical seed forces full restart");
+        var (budget,bc)=Fixture(2);var br=Repair(budget,bc[0]);
+        Check(br.Wet.Count==0 && br.Pending.Count==1 && budget._reach!.Disabled,"repair budget rollback discards partially accepted cells");
+        var (broken,ic)=Fixture();broken._reach!.Order[2]=new ReachNode(ic[2],broken._reach.Order[0]);var ir=Repair(broken,ic[0]);
+        Check(ir.Wet.Count==0 && broken._reach.Disabled,"invalid parent face cannot reattach");
+        var (missing,mc)=Fixture();missing._reach!.Nodes.Remove(mc[3].Key);
+        missing.DiscoverReachability(new Cell(new(32,0,8),1,1,false,null),mc[3]);var mr=Repair(missing,mc[0]);
+        Check(mr.Wet.Count==0 && missing._reach.Disabled,"missing dependency falls back");
+        var (unknown,uc)=Fixture();var unresolved=new Cell(new(0,-8,8),1,0,true,null);
+        unknown._expansions![uc[0].Key]=new(uc[0],0,new[]{unresolved},new[]{0});var ur=Repair(unknown,uc[0]);
+        Check(!ur.Wet.ContainsKey(uc[0].Key) && ur.Pending.ContainsKey(uc[0].Key),"uncertain neighbour always reobserved");
+        var (absent,ac)=Fixture();absent._expansions!.Remove(ac[4].Key);var ar=Repair(absent,ac[0]);
+        Check(!ar.Wet.ContainsKey(ac[4].Key) && ar.Pending.ContainsKey(ac[4].Key),"missing expansion cannot imply closed boundary");
+        Console.WriteLine($"REACHABILITY_PROOF_PASS: {checks} checks");return checks;
+    }
+}
