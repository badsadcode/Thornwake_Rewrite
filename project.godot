config_version=5

[application]
config/name="Thornwake"
config/version="0.9.26"
run/main_scene="res://Game/Launcher.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/description="A life at the edge of the wild. First playable prototype."
config/use_custom_user_dir=true
config/custom_user_dir_name="Thornwake"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="Thornwake"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.13,0.18,0.19,1)

[environment]
defaults/default_clear_color=Color(0.13,0.18,0.19,1)

[shader_globals]

cloud_state={
"type": "vec4",
"value": Vector4(0, 0, 0.45, 0)
}
ocean_time={
"type": "float",
"value": 0.0
}
rain_wetness={
"type": "vec2",
"value": Vector2(0, 0)
}
leaf_translucency={
"type": "float",
"value": 0.0
}
cloud_layers={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
sky_mood={
"type": "vec4",
"value": Vector4(1, 1, 1, 0)
}
sun_glow={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
sun_dir_world={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
night_sky={
"type": "vec4",
"value": Vector4(0, -1, 0, 0.5)
}
star_rotation={
"type": "mat3",
"value": Basis(1, 0, 0, 0, 1, 0, 0, 0, 1)
}
sky_extra={
"type": "vec4",
"value": Vector4(0, 1, 1, 1)
}
wind={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
sun_true={
"type": "vec4",
"value": Vector4(0, 1, 0, 45)
}
aurora={
"type": "float",
"value": 0.0
}
cloud_types={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cloud_lens={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
relief_frame={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cloud_front={
"type": "vec4",
"value": Vector4(1, 0, 0, 0)
}
cloud_more={
"type": "vec4",
"value": Vector4(0, 0, 0, 1500)
}
